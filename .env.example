# Database
DATABASE_URL=jdbc:postgresql://localhost:5433/certifyapp
DATABASE_USERNAME=certifyapp
DATABASE_PASSWORD=certifyapp

# Redis
REDIS_URL=redis://localhost:6380

# RabbitMQ
RABBITMQ_URL=amqp://certifyapp:certifyapp@localhost:5672
RABBITMQ_USERNAME=certifyapp
RABBITMQ_PASSWORD=certifyapp

# JWT (dev only — use AWS Secrets Manager in production)
JWT_SECRET=change-me-in-production-use-at-least-256-bits
JWT_ISSUER=certifyapp
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# AWS S3
AWS_REGION=eu-central-1
AWS_S3_BUCKET=certifyapp-dev
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
AWS_S3_ENDPOINT=http://localhost:4566

# Stripe
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SendGrid
SENDGRID_API_KEY=SG.xxx

# OAuth2 (placeholders)
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_APPLE_CLIENT_ID=
